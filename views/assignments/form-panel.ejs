<div class="drawer-head">
  <div class="drawer-title">
    <h2 id="drawer-title"><%= isNew ? 'New assignment' : 'Edit assignment' %></h2>
    <div class="muted small-text"><%= lockEmployee.name %> · <%= lockEmployee.code %></div>
  </div>
  <button type="button" class="icon-btn" data-close-dialog aria-label="Close">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M18.3 5.71 12 12.01l-6.3-6.3-1.41 1.41 6.3 6.3-6.3 6.3 1.41 1.41 6.3-6.3 6.3 6.3 1.41-1.41-6.3-6.3 6.3-6.3z"/></svg>
  </button>
</div>
<div class="drawer-body">
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="<%= isNew ? '/assignments' : `/assignments/${a.id}` %>" data-panel-form>
    <%- include('../partials/csrf') %>
    <input type="hidden" name="_panel" value="1">
    <%- include('_fields', { idPrefix: 'ap-' }) %>
    <div class="form-actions">
      <button class="btn" type="submit"><%= isNew ? 'Create assignment' : 'Save' %></button>
      <button class="btn secondary" type="button" data-panel-load="/employees/<%= a.employee_id %>?panel=1" data-discard-check>Cancel</button>
    </div>
  </form>
</div>
