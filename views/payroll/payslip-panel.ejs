<div class="drawer-head">
  <div class="drawer-title">
    <h2 id="drawer-title">Payslip — <%= slip.employee_name %></h2>
    <div class="muted small-text"><%= f.monthLabel(slip.month) %> · net pay <%= f.money(slip.net_pay) %></div>
  </div>
  <button type="button" class="icon-btn" data-close-dialog aria-label="Close payslip">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M18.3 5.71 12 12.01l-6.3-6.3-1.41 1.41 6.3 6.3-6.3 6.3 1.41 1.41 6.3-6.3 6.3 6.3 1.41-1.41-6.3-6.3 6.3-6.3z"/></svg>
  </button>
</div>
<div class="drawer-actions">
  <button type="button" class="btn" data-print-panel>Print / Save as PDF</button>
</div>
<div class="drawer-body">
  <%- include('_payslip-doc') %>
</div>
