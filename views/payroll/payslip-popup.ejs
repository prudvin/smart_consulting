<div class="popup-head no-print">
  <h2 id="popup-title">Payslip — <%= slip.employee_name %>, <%= f.monthLabel(slip.month) %></h2>
  <div class="popup-actions">
    <button type="button" class="btn" data-print-popup>Print / Save as PDF</button>
    <a class="btn secondary" href="/payroll/payslips/<%= slip.id %>">Open full page</a>
    <button type="button" class="icon-btn" data-close-dialog aria-label="Close payslip">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M18.3 5.71 12 12.01l-6.3-6.3-1.41 1.41 6.3 6.3-6.3 6.3 1.41 1.41 6.3-6.3 6.3 6.3 1.41-1.41-6.3-6.3 6.3-6.3z"/></svg>
    </button>
  </div>
</div>
<div class="popup-body">
  <%- include('_payslip-doc') %>
</div>
