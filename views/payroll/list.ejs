<%- include('../partials/header') %>
<h1>Payroll</h1>
<div class="card">
  <h2>Generate payroll</h2>
  <form method="post" action="/payroll/generate" class="filters" style="margin: 0"
        data-generate-payroll data-existing="<%= JSON.stringify(Object.fromEntries(runs.map(r => [r.month, r.status]))) %>"
        data-admin="<%= user.role === 'admin' ? '1' : '' %>">
    <%- include('../partials/csrf') %>
    <div><label for="month">Month</label><input id="month" type="month" name="month" value="<%= month %>" required></div>
    <div><button class="btn" type="submit">Generate payroll</button></div>
  </form>
</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Month</th><th>Status</th><th class="num">Employees</th><th class="num">Gross</th><th class="num">Deductions</th><th class="num">Net pay</th><th>Generated</th><th></th></tr></thead>
    <tbody>
      <% for (const r of runs) { %>
        <tr class="clickable-row" tabindex="0" data-href="/payroll/<%= r.id %>" aria-label="Open payroll for <%= f.monthLabel(r.month) %>">
          <td><a href="/payroll/<%= r.id %>"><strong><%= f.monthLabel(r.month) %></strong></a></td>
          <td><span class="badge <%= r.status %>"><%= r.status %></span></td>
          <td class="num"><%= r.employees %></td>
          <td class="num"><%= f.money(r.gross) %></td>
          <td class="num"><%= f.money(r.deductions) %></td>
          <td class="num"><%= f.money(r.net) %></td>
          <td class="muted small-text"><%= r.created_at %><%= r.created_by_name ? ` by ${r.created_by_name}` : '' %></td>
          <td class="actions">
            <%- include('_regenerate', { run: r, small: true }) %>
          </td>
        </tr>
      <% } %>
      <% if (!runs.length) { %><tr><td colspan="8" class="empty">No payroll has been generated yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
