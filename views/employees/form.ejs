<%- include('../partials/header') %>
<h1><%= title %></h1>
<div class="card">
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="<%= isNew ? '/employees' : `/employees/${e.id}` %>">
    <%- include('../partials/csrf') %>
    <%- include('_fields') %>
    <div class="form-actions">
      <button class="btn" type="submit"><%= isNew ? 'Add employee' : 'Save' %></button>
      <a class="btn secondary" href="<%= isNew ? '/employees' : `/employees/${e.id}` %>">Cancel</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
