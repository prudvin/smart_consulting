<div class="drawer-head">
  <div class="drawer-title">
    <h2 id="drawer-title"><%= e.name %> <span class="badge <%= e.status %>"><%= e.status %></span></h2>
    <div class="muted small-text"><%= e.code %><%= e.cur_designation ? ` · ${e.cur_designation}` : '' %></div>
  </div>
  <button type="button" class="icon-btn" data-close-dialog aria-label="Close details">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M18.3 5.71 12 12.01l-6.3-6.3-1.41 1.41 6.3 6.3-6.3 6.3 1.41 1.41 6.3-6.3 6.3 6.3 1.41-1.41-6.3-6.3 6.3-6.3z"/></svg>
  </button>
</div>
<% if (locals.fromCustomer) { %>
  <div class="drawer-back"><a href="/customers/<%= fromCustomer.id %>" data-panel-load="/customers/<%= fromCustomer.id %>?panel=1">← Back to <%= fromCustomer.name %></a></div>
<% } %>
<div class="drawer-actions">
  <a class="btn" href="/employees/<%= e.id %>/edit" data-panel-load="/employees/<%= e.id %>/edit?panel=1">Edit</a>
</div>
<div class="drawer-body">
  <% if (locals.savedMsg) { %><div class="flash success"><%= savedMsg %></div><% } %>
  <%- include('_details') %>
</div>
