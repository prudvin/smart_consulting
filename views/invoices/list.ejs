<%- include('../partials/header') %>
<div class="page-head">
  <h1>Invoices</h1>
  <div class="buttons"><a class="btn secondary" href="/invoices/new">New invoice</a></div>
</div>
<div class="card">
  <h2>Generate monthly invoices</h2>
  <form method="post" action="/invoices/generate" class="filters" style="margin: 0">
    <%- include('../partials/csrf') %>
    <div><label for="gen-month">Month</label><input id="gen-month" type="month" name="month" value="<%= generateMonth %>" required></div>
    <div><button class="btn" type="submit">Generate invoices</button></div>
  </form>
  <p class="hint">Creates one draft invoice per active customer with assignments in the month, built from each assignment's billing basis and the attendance register. Customers already invoiced for that month are skipped.</p>
</div>

<form class="filters" method="get">
  <div><label for="month">Month</label><input id="month" type="month" name="month" value="<%= month %>"></div>
  <div>
    <label for="customer_id">Customer</label>
    <select id="customer_id" name="customer_id">
      <option value="">All customers</option>
      <% for (const c of customers) { %><option value="<%= c.id %>" <%= c.id === customer_id ? 'selected' : '' %>><%= c.name %></option><% } %>
    </select>
  </div>
  <div>
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="">All</option>
      <% for (const s of INVOICE_STATUSES) { %><option <%= s === status ? 'selected' : '' %>><%= s %></option><% } %>
    </select>
  </div>
  <div><button class="btn secondary" type="submit">Filter</button> <a href="/invoices">Clear</a></div>
</form>

<div class="table-wrap">
  <table>
    <thead><tr><th>Number</th><th>Customer</th><th>Month</th><th>Invoice date</th><th>Due</th><th class="num">Subtotal</th><th class="num">Tax</th><th class="num">Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% for (const i of invoices) { %>
        <tr>
          <td><a href="/invoices/<%= i.id %>"><strong><%= i.number %></strong></a></td>
          <td><%= i.customer_name %></td>
          <td><%= f.monthLabel(i.month) %></td>
          <td><%= f.fmtDate(i.invoice_date) %></td>
          <td><%= f.fmtDate(i.due_date) %></td>
          <td class="num"><%= f.money(i.subtotal) %></td>
          <td class="num"><%= f.money(i.tax_amount) %></td>
          <td class="num"><strong><%= f.money(i.total) %></strong></td>
          <td><span class="badge <%= i.status %>"><%= i.status %></span></td>
          <td class="actions">
            <a class="btn small secondary" href="/invoices/<%= i.id %>">View</a>
          </td>
        </tr>
      <% } %>
      <% if (!invoices.length) { %><tr><td colspan="10" class="empty">No invoices found.</td></tr><% } %>
    </tbody>
    <% if (invoices.length) { %>
      <tfoot><tr><td colspan="7">Total (excluding cancelled)</td><td class="num"><%= f.money(total) %></td><td colspan="2"></td></tr></tfoot>
    <% } %>
  </table>
</div>
<%- include('../partials/footer') %>
