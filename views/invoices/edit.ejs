<%- include('../partials/header') %>
<div class="page-head">
  <h1>Edit invoice <%= inv.number %></h1>
  <div class="buttons"><a href="/invoices/<%= inv.id %>">View invoice</a></div>
</div>
<% function lineRow(i, l) { %>
  <tr data-line>
    <td><input name="lines[<%= i %>][description]" value="<%= l.description || '' %>" placeholder="Description"></td>
    <td><input type="number" name="lines[<%= i %>][quantity]" value="<%= l.quantity ?? 1 %>" step="0.01" min="0" data-qty></td>
    <td><input name="lines[<%= i %>][unit]" value="<%= l.unit || '' %>" placeholder="month"></td>
    <td><input type="number" name="lines[<%= i %>][rate]" value="<%= l.rate ?? 0 %>" step="0.01" min="0" data-rate></td>
    <td class="num" data-amount><%= f.amount((l.quantity || 0) * (l.rate || 0)) %></td>
    <td class="actions"><button type="button" class="btn small secondary" data-remove-row>Remove</button></td>
  </tr>
<% } %>
<div class="card">
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <p><strong><%= inv.customer_name %></strong> · <%= f.monthLabel(inv.month) %></p>
  <form method="post" action="/invoices/<%= inv.id %>">
    <%- include('../partials/csrf') %>
    <div class="form-grid">
      <div><label for="invoice_date">Invoice date</label><input id="invoice_date" type="date" name="invoice_date" value="<%= inv.invoice_date %>" required></div>
      <div><label for="due_date">Due date</label><input id="due_date" type="date" name="due_date" value="<%= inv.due_date || '' %>"></div>
      <div><label for="tax_rate">Tax rate (%)</label><input id="tax_rate" type="number" name="tax_rate" value="<%= inv.tax_rate %>" step="0.01" min="0" max="100"></div>
    </div>

    <h2>Line items</h2>
    <div class="table-wrap">
      <table data-invoice-lines>
        <thead><tr><th>Description</th><th style="width: 110px">Qty</th><th style="width: 110px">Unit</th><th style="width: 140px">Rate (₹)</th><th class="num" style="width: 130px">Amount</th><th></th></tr></thead>
        <tbody id="lines"><% lines.forEach((l, i) => lineRow(i, l)); %></tbody>
        <tfoot>
          <tr><td colspan="4" class="num">Subtotal</td><td class="num" data-subtotal></td><td></td></tr>
          <tr><td colspan="4" class="num">Tax</td><td class="num" data-tax></td><td></td></tr>
          <tr><td colspan="4" class="num">Total</td><td class="num" data-total></td><td></td></tr>
        </tfoot>
      </table>
    </div>
    <template id="line-tpl"><% lineRow('__i__', { quantity: 1, rate: 0 }); %></template>
    <button type="button" class="btn small secondary" data-add-row="lines" data-template="line-tpl">+ Add line</button>

    <div style="margin-top: 16px"><label for="notes">Notes <span class="hint">(shown on the invoice)</span></label><textarea id="notes" name="notes"><%= inv.notes || '' %></textarea></div>

    <div class="form-actions">
      <button class="btn" type="submit">Save invoice</button>
      <a class="btn secondary" href="/invoices/<%= inv.id %>">Cancel</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
